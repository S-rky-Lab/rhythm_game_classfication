/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
/prisma/*.sqlite3

# local uploads and generated assets
/uploads/
/public/uploads/

# local development and editor files
.eslintcache
.idea/
.vscode/
*.swp
*.swo

# OS files
Thumbs.db

# local agent instructions
AGENTS.md
CLAUDE.md
